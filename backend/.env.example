# Copy to backend/.env and adjust. .env files are git-ignored - never commit real values.
# Load it with:  uvicorn app.main:app --reload --env-file .env

# Database (omit to use the local SQLite file backend/spendgpt.db)
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:4000/student_spend_db

# LM Studio local server (OpenAI-compatible API). The React app never calls it directly.
LM_STUDIO_ENABLED=true
LM_STUDIO_BASE_URL=http://localhost:1234/v1
# Model identifier as shown in LM Studio, e.g. qwen2.5-7b-instruct (recommended: set it).
# Empty = the loaded chat model with the largest context window.
LM_STUDIO_MODEL=
# Only needed if "Require API token" is enabled in LM Studio's server settings.
LM_STUDIO_API_KEY=
LM_STUDIO_TIMEOUT=60
LM_STUDIO_CONNECT_TIMEOUT=5

# BasketWatch MCP server, used to compare receipt prices with the supermarkets' online prices
BASKETWATCH_ENABLED=true
BASKETWATCH_MCP_URL=https://basketwatchireland.com/mcp
BASKETWATCH_TIMEOUT=20
BASKETWATCH_MAX_ITEMS=15
